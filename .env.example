# Cấu hình kết nối cơ sở dữ liệu PostgreSQL (VD: NeonDB, Supabase hoặc Northflank PostgreSQL addon)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Telegram Bot Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# API Key cho Google Gemini
GEMINI_API_KEY="your_gemini_api_key"

# Chu kỳ chạy Cron (Mặc định: */3 * * * * cho 3 phút/lần hoặc */1 * * * * cho 1 phút/lần)
CRON_SCHEDULE="*/3 * * * *"

# Cổng khởi chạy server (Northflank thường tự inject PORT hoặc dùng 3001)
PORT=3001

# CallMeBot Telegram Voice Call (CHỈ gọi báo thức khi đạt TIER SSS hoặc SMC+NWE Tier 3)
# Xem hướng dẫn chi tiết từng bước tại file CALLMEBOT_SETUP.md
CALLMEBOT_ENABLED=false
# Điền @username cá nhân Telegram của bạn (KHÔNG điền username của bot), nhiều người cách nhau bởi dấu phẩy
CALLMEBOT_USERS=@your_personal_telegram_username
CALLMEBOT_LANG=vi-VN-Standard-A
CALLMEBOT_REPEAT=2
CALLMEBOT_CC=missed
CALLMEBOT_COOLDOWN_SEC=60
