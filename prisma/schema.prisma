datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelegramUser {
  id                 Int      @id @default(autoincrement())
  chatId             String   @unique
  username           String?
  macroAlertLevels   Int[]    @default([1, 0])
  xauAlertEnabled    Boolean  @default(true)
  xauAlertTimeframes String[] @default(["M15", "M30", "H1", "H4", "D1"])
  xauOverboughtRsi   Float    @default(70)
  xauOversoldRsi     Float    @default(30)
  bbAtrAlertEnabled   Boolean  @default(true)
  bbTier0AlertEnabled Boolean  @default(true)
  tier1AlertEnabled   Boolean  @default(true)
  tier2SignalEnabled  Boolean  @default(true)
  tier3AlertEnabled   Boolean  @default(true)
  tierSssAlertEnabled Boolean  @default(true)
  bbAtrBias           String   @default("BOTH") // "BOTH", "BUY_ONLY", "SELL_ONLY"
  nweAlertEnabled    Boolean  @default(true)
  nweTimeframes      String[] @default(["M5", "M15", "H1", "H4"])
  smcAlertEnabled    Boolean  @default(true)
  smcTimeframes      String[] @default(["M5", "M15", "H1", "H4"])
  tier2AlertEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@map("telegram_users")
}

model MacroAlertLog {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  title     String
  country   String
  eventDate DateTime
  actual    String
  forecast  String?
  previous  String?
  createdAt DateTime @default(now())

  @@map("macro_alert_logs")
}

model XauAlertLog {
  id        Int      @id @default(autoincrement())
  timeframe String
  rsi       Float
  price     Float
  alertType String
  message   String
  createdAt DateTime @default(now())

  @@map("xau_alert_logs")
}

model PriceAlert {
  id             Int       @id @default(autoincrement())
  chatId         String
  username       String?
  symbol         String    // "XAU", "BTC", "ETH", "SOL", ...
  displaySymbol  String    // "XAU/USD", "BTC/USDT", ...
  assetType      String    // "GOLD", "CRYPTO"
  targetPrice    Float
  initialPrice   Float
  condition      String    // "ABOVE", "BELOW"
  status         String    @default("ACTIVE") // "ACTIVE", "TRIGGERED", "CANCELLED"
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([chatId, status])
  @@map("price_alerts")
}

model BbAtrAlert {
  id              Int       @id @default(autoincrement())
  chatId          String
  username        String?
  symbol          String    // "XAU", "BTC", "ETH", ...
  displaySymbol   String    // "XAU/USD (Vàng)", "BTC/USDT", ...
  assetType       String    // "GOLD", "CRYPTO"
  timeframe       String    @default("M5")
  bbPeriod        Int       @default(20)
  bbStdDev        Float     @default(2.0)
  atrPeriod       Int       @default(14)
  bias            String    @default("BOTH") // "BOTH", "BUY_ONLY", "SELL_ONLY"
  lastSignal      String?   // "BUY", "SELL", "NORMAL"
  lastSignalPrice Float?
  lastTriggeredAt DateTime?
  status          String    @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([chatId, status])
  @@map("bb_atr_alerts")
}

model BbAtrAlertLog {
  id          Int      @id @default(autoincrement())
  symbol      String
  timeframe   String
  signalType  String   // "BUY", "SELL"
  price       Float
  bbUpper     Float
  bbLower     Float
  bbMiddle    Float
  atr         Float
  entryTarget Float
  slPrice     Float?
  message     String
  createdAt   DateTime @default(now())

  @@map("bb_atr_alert_logs")
}

model SmcAlertLog {
  id         Int      @id @default(autoincrement())
  symbol     String
  timeframe  String
  alertType  String   // "DEMAND_OB", "SUPPLY_OB", "NWE_UPPER", "NWE_LOWER", "CONFLUENCE_BUY", "CONFLUENCE_SELL"
  price      Float
  zoneTop    Float?
  zoneBottom Float?
  message    String
  createdAt  DateTime @default(now())

  @@map("smc_alert_logs")
}



